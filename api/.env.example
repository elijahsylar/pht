# Copy to api/.env for `npm run dev` / `npm start` against a real MySQL.
# Not needed for `npm run dev:fake`, which uses an in-memory store.
PORT=4100
DB_HOST=localhost
DB_USER=pht
DB_PASSWORD=change-me
DB_NAME=pht
# Long random string; rotating it signs every browser out.
JWT_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
# bcrypt hash of the admin password, e.g.:
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1], 12))" 'your password'
ADMIN_PASSWORD_HASH=
# Weather window: the forecast location, rounded to 2 decimals. Optional;
# without it the Weather window says it is not configured. Example: Berlin.
WEATHER_LAT=52.52
WEATHER_LON=13.41
