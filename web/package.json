{
  "name": "personal-habit-tracker",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "preview": "vite preview",
    "ui:check": "bash dev/run-ui-check.sh",
    "ui:check:firefox": "UI_BROWSER=firefox bash dev/run-ui-check.sh"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "1.64.1",
    "typescript": "~5.6.2",
    "vite": "^5.4.21",
    "vitest": "^3.2.7"
  }
}
